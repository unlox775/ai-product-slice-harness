PHASE ?= phase-07-iterate
LINES ?= 5
INTERVAL ?= 1
ARGS ?=
RUN_ID ?=
REARCH_ID ?=

ifeq ($(strip $(RUN_ID)),)
RUN_ENV =
else
RUN_ENV = PHASE_RUN_ID="$(RUN_ID)"
endif

ifeq ($(strip $(REARCH_ID)),)
REARCH_ENV =
else
REARCH_ENV = REARCH_ID="$(REARCH_ID)"
endif

.PHONY: help harness-help phase-3 phase-4 phase-5 phase-6 phase-7 phase-7-serial phase-7-dry-run phase-7-notes phase-ra-3 phase-ra-4 phase-ra-5 phase-ra-6 phase-ra-complete phase-ra-abandon watch status

help harness-help:
	@echo "AI Product Slice Harness targets:"
	@echo "  make phase-3                         Run Phase 03 product-spec agents"
	@echo "  make phase-4                         Run Phase 04 customer-request agents"
	@echo "  make phase-5                         Run Phase 05 producer-response agents"
	@echo "  PHASE_CONFIRMED=1 make phase-6       Run gated Phase 06 first implementation"
	@echo "  make phase-7                         Run Phase 07 iteration"
	@echo "  make phase-7-serial                  Run Phase 07 one product at a time"
	@echo "  make phase-7-dry-run                 Preview unresolved Phase 07 specs"
	@echo "  make phase-7-notes                   Regenerate version-history notes"
	@echo "  make phase-ra-3 .. phase-ra-5        Re-architecture planning agents"
	@echo "  PHASE_CONFIRMED=1 make phase-ra-6    Gated re-architecture implementation"
	@echo "  PHASE_CONFIRMED=1 make phase-ra-complete"
	@echo "  make phase-ra-abandon                Mark selected re-architecture abandoned"
	@echo "  make watch                           Watch latest run for PHASE=$(PHASE)"
	@echo "  make status                          Show latest run status for PHASE=$(PHASE)"
	@echo ""
	@echo "Variables: PHASE, RUN_ID, REARCH_ID, LINES, INTERVAL, ARGS, PHASE_ONLY"

phase-3:
	$(RUN_ENV) bash subagents/phase-03-product-specs.sh $(ARGS)

phase-4:
	$(RUN_ENV) bash subagents/phase-04-customer-requests.sh $(ARGS)

phase-5:
	$(RUN_ENV) bash subagents/phase-05-producer-responses.sh $(ARGS)

phase-6:
	$(RUN_ENV) bash subagents/phase-06-first-implementation.sh $(ARGS)

phase-7:
	$(RUN_ENV) bash subagents/phase-07-iterate.sh $(ARGS)

phase-7-serial:
	$(RUN_ENV) bash subagents/phase-07-iterate.sh --serial $(ARGS)

phase-7-dry-run:
	bash subagents/phase-07-iterate.sh --dry-run $(ARGS)

phase-7-notes:
	@if [ -n "$(strip $(RUN_ID))" ]; then \
		python3 scripts/generate-phase-07-notes.py "$(RUN_ID)"; \
	else \
		python3 scripts/generate-phase-07-notes.py; \
	fi

phase-ra-3:
	$(REARCH_ENV) $(RUN_ENV) bash subagents/phase-ra-03-product-specs.sh $(ARGS)

phase-ra-4:
	$(REARCH_ENV) $(RUN_ENV) bash subagents/phase-ra-04-customer-requests.sh $(ARGS)

phase-ra-5:
	$(REARCH_ENV) $(RUN_ENV) bash subagents/phase-ra-05-producer-responses.sh $(ARGS)

phase-ra-6:
	$(REARCH_ENV) $(RUN_ENV) bash subagents/phase-ra-06-implementation.sh $(ARGS)

phase-ra-complete:
	$(REARCH_ENV) $(RUN_ENV) bash subagents/phase-ra-07-complete.sh $(ARGS)

phase-ra-abandon:
	$(REARCH_ENV) bash subagents/phase-ra-abandon.sh

watch:
	$(RUN_ENV) bash docs/ai-product-slice-harness/watch-phase.sh "$(PHASE)" "$(LINES)" "$(INTERVAL)"

status:
	@if [ -n "$(strip $(RUN_ID))" ]; then \
		PHASE_RUN_ID="$(RUN_ID)" bash subagents/phase-status.sh "$(PHASE)" --verbose; \
	elif [ -f "subagents/status/$(PHASE).latest-run" ]; then \
		PHASE_RUN_ID="$$(sed -n '1p' "subagents/status/$(PHASE).latest-run")" bash subagents/phase-status.sh "$(PHASE)" --verbose; \
	else \
		bash subagents/phase-status.sh "$(PHASE)" --verbose; \
	fi
