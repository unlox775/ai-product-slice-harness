# Project-specific paths used by harness agent prompts.
# Install copies this to config.env; edit after Phase 01 if your filenames differ.

HARNESS_PROCESS_DOC=docs/AI-PRODUCT-SLICE-HARNESS.md
HARNESS_FOUNDER_VISION=docs/FOUNDER-vision.md
HARNESS_SLICE_UP_PLAN=docs/SLICE-UP-plan.md

# Phase 03+ agent runtime. Default is Codex (local worktree, waits).
# Use cursor for Cursor Cloud Agents (remote branch/PR, fire-and-forget by default).
# The process environment overrides this file.
# HARNESS_AGENT_PROVIDER=codex

# Cursor Cloud Agents (only when HARNESS_AGENT_PROVIDER=cursor)
# Put CURSOR_API_KEY in the environment — do not commit it here.
# HARNESS_CURSOR_REPO=https://github.com/your-org/your-repo
# HARNESS_CURSOR_REF=main
# HARNESS_CURSOR_MODEL=default
# HARNESS_CURSOR_WAIT=0
# HARNESS_CURSOR_DRY_RUN=0
# HARNESS_CURSOR_AUTO_CREATE_PR=1
# HARNESS_CURSOR_API_BASE=https://api.cursor.com
# HARNESS_CURSOR_POLL_SECONDS=15
# HARNESS_CURSOR_WAIT_TIMEOUT=0
# HARNESS_CURSOR_BRANCH_NAME=
